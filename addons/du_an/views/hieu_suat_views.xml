<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Hiệu suất Nhân viên Kanban View -->
    <record id="view_hieu_suat_nhan_vien_kanban" model="ir.ui.view">
        <field name="name">nhan_vien.hieu_suat.kanban</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="ho_va_ten"/>
                <field name="phong_ban_id"/>
                <field name="tong_tac_vu"/>
                <field name="tac_vu_hoan_thanh"/>
                <field name="ty_le_hoan_thanh"/>
                <field name="ty_le_dung_deadline"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb8">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="ho_va_ten"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle text-muted">
                                            <field name="phong_ban_id"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="container o_kanban_card_content">
                                    <div class="row mb8">
                                        <div class="col-6">
                                            <span class="text-muted">Tác vụ:</span>
                                            <strong><field name="tac_vu_hoan_thanh"/>/<field name="tong_tac_vu"/></strong>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <span class="text-muted">Hoàn thành:</span>
                                            <strong t-attf-class="#{record.ty_le_hoan_thanh.raw_value >= 80 ? 'text-success' : record.ty_le_hoan_thanh.raw_value >= 50 ? 'text-warning' : 'text-danger'}">
                                                <field name="ty_le_hoan_thanh" widget="float" digits="[3, 0]"/>%
                                            </strong>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted">Đúng hạn:</span>
                                            <strong t-attf-class="#{record.ty_le_dung_deadline.raw_value >= 80 ? 'text-success' : record.ty_le_dung_deadline.raw_value >= 50 ? 'text-warning' : 'text-danger'}">
                                                <field name="ty_le_dung_deadline" widget="float" digits="[3, 0]"/>%
                                            </strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard Tree View -->
    <record id="view_hieu_suat_nhan_vien_tree" model="ir.ui.view">
        <field name="name">nhan_vien.hieu_suat.tree</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
            <tree string="Hiệu suất nhân viên">
                <field name="ho_va_ten"/>
                <field name="phong_ban_id"/>
                <field name="tong_tac_vu"/>
                <field name="tac_vu_hoan_thanh"/>
                <field name="ty_le_hoan_thanh" widget="progressbar"/>
                <field name="tac_vu_dung_han"/>
                <field name="ty_le_dung_deadline" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <!-- Action for Dashboard Hiệu suất -->
    <record id="action_hieu_suat_nhan_vien" model="ir.actions.act_window">
        <field name="name">Dashboard Hiệu suất</field>
        <field name="res_model">nhan_vien</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_hieu_suat_nhan_vien_kanban')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hieu_suat_nhan_vien_tree')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Dashboard hiệu suất nhân viên
            </p>
            <p>
                Theo dõi hiệu suất làm việc của từng nhân viên.
            </p>
        </field>
    </record>
</odoo>
