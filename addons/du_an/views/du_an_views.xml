<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_du_an_tree" model="ir.ui.view">
        <field name="name">du.an.tree</field>
        <field name="model">du.an</field>
        <field name="arch" type="xml">
            <tree >
                <field name="name"/>
                <field name="ngay_bat_dau"/>
                <field name="ngay_ket_thuc"/>
                <field name="tong_chi_phi"/>
                <field name="trang_thai"/>
                <field name="cong_viec_ids"/>
                <field name="phan_tram_hoan_thanh" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <record id="view_du_an_form" model="ir.ui.view">
        <field name="name">du.an.form</field>
        <field name="model">du.an</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_du_bao_rui_ro" type="object" string="Dự báo Rủi ro" class="btn-warning" icon="fa-bolt"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" style="font-weight: bold; font-size: 20px; color: #2c3e50;"/>
                            <field name="ngay_bat_dau" widget="date"/>
                            <field name="ngay_ket_thuc" widget="date"/>
                            <field name="mo_ta"/>
                            <field name="tong_chi_phi"/>
                            <field name="trang_thai"/>
                            <field name="phan_tram_hoan_thanh" widget="progressbar"/>
                        </group>
                        <group string="Phân tích AI">
                            <field name="muc_do_rui_ro" widget="badge" decoration-success="muc_do_rui_ro == 'thap'" decoration-warning="muc_do_rui_ro == 'trung_binh'" decoration-danger="muc_do_rui_ro == 'cao'"/>
                            <field name="phan_tich_rui_ro"/>
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="Danh sách công việc">
                                <field name="cong_viec_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="mo_ta"/>
                                        <field name="moc_id"/>
                                        <field name="uu_tien"/>
                                        <field name="trang_thai"/>
                                        <field name="trong_so"/>
                                        <field name="phan_tram_hoan_thanh" widget="progressbar"/>
                                        <field name="thoi_gian_du_kien"/>
                                        <field name="deadline"/>
                                    </tree>   
                                </field>
                            </page>
                            <page string="Mốc dự án">
                                <field name="moc_du_an_ids">
                                    <tree editable="bottom" decoration-success="trang_thai=='achieved'" decoration-danger="trang_thai=='delayed'">
                                        <field name="name"/>
                                        <field name="ngay_du_kien"/>
                                        <field name="ngay_hoan_thanh"/>
                                        <field name="phan_tram_hoan_thanh" widget="progressbar"/>
                                        <field name="trang_thai"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Danh sách nhân sự">
                                <field name="thanh_vien_ids" />
                            </page>
                            <page string="Chi phí dự án">
                                <field name="chi_phi_ids" />
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>   

    <record id="view_du_an_search" model="ir.ui.view">
        <field name="name">du.an.search</field>
        <field name="model">du.an</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ngay_bat_dau"/>
                <field name="ngay_ket_thuc"/>
                <field name="tong_chi_phi"/>
            </search>
        </field>
    </record>

    
    <record id="action_du_an_list" model="ir.actions.act_window">
        <field name="name">Danh sách dự án</field>
        <field name="res_model">du.an</field>
        <field name="view_mode">tree,form,search</field>
    </record>
</odoo>