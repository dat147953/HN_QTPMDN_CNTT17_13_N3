<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Báo cáo Tiến độ -->
    <record id="view_bao_cao_tien_do_form" model="ir.ui.view">
        <field name="name">bao.cao.tien.do.form</field>
        <field name="model">bao.cao.tien.do</field>
        <field name="arch" type="xml">
            <form string="Báo cáo Tiến độ">
                <header>
                    <button name="action_gui_bao_cao" type="object" 
                            string="Gửi báo cáo" class="oe_highlight"
                            attrs="{'invisible': [('trang_thai', '!=', 'draft')]}"/>
                    <button name="action_ai_audit" type="object"
                            string="AI Check" class="btn-warning" icon="fa-robot"
                            attrs="{'invisible': [('trang_thai', '==', 'draft')]}"/>
                    <button name="action_danh_dau_da_xem" type="object"
                            string="Đánh dấu đã xem" class="btn-primary"
                            attrs="{'invisible': [('trang_thai', '!=', 'submitted')]}"/>
                    <field name="trang_thai" widget="statusbar" 
                           statusbar_visible="draft,submitted,reviewed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Rủi ro Cao" bg_color="bg-danger" 
                            attrs="{'invisible': [('ai_risk_flag', '=', False)]}"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tiêu đề báo cáo..."/>
                        </h1>
                    </div>
                    <group>
                        <!-- Group 1: Định danh (Cấp 1) -->
                        <group string="1. Định danh">
                            <field name="nguoi_bao_cao_id" options="{'no_create': True}"/>
                            <field name="ngay_bao_cao"/>
                        </group>
                        
                        <!-- Group 2: Phân cấp dữ liệu (Cascading Selection) -->
                        <group string="2. Chọn Đối tượng" attrs="{'invisible': [('nguoi_bao_cao_id', '=', False)]}">
                            <!-- Cấp 2: Dự án (Lọc theo Nhân viên) -->
                            <field name="du_an_id" 
                                   options="{'no_create': True}"/>
                                   
                            <!-- Cấp 3: Công việc (Lọc theo Dự án) -->
                            <field name="cong_viec_id" 
                                   options="{'no_create': True}"
                                   attrs="{'invisible': [('du_an_id', '=', False)]}"/>
                                   
                            <!-- Cấp 4: Tác vụ (Lọc theo Công việc) -->
                            <field name="tac_vu_id" 
                                   options="{'no_create': True}"
                                   attrs="{'invisible': [('cong_viec_id', '=', False)]}"/>
                        </group>
                    </group>
                    
                    <!-- Group 3: Nội dung (Cấp 5 - Chỉ hiện khi đã chọn Task) -->
                    <notebook attrs="{'invisible': [('tac_vu_id', '=', False)]}">
                        <page string="3. Nội dung báo cáo" name="content">
                            <field name="noi_dung" widget="html" 
                                   placeholder="Nhập nội dung chi tiết báo cáo tiến độ..."
                                   options="{'height': 300}"/>
                        </page>
                        <page string="Hình ảnh minh chứng" name="images">
                            <field name="hinh_anh_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="hinh_anh" widget="image" 
                                           options="{'size': [100, 100]}"
                                           class="o_image_64_contain"/>
                                    <field name="hinh_anh_filename" invisible="1"/>
                                    <field name="chu_thich"/>
                                </tree>
                            </field>
                            <div class="text-muted mt-2">
                                <i class="fa fa-info-circle"/> Hỗ trợ định dạng: JPG, PNG. Click vào ảnh để xem preview lớn hơn.
                            </div>
                        </page>
                        <page string="AI Auditor" name="ai_audit" attrs="{'invisible': [('trang_thai', '=', 'draft')]}">
                            <group>
                                <group string="Kết quả Đánh giá">
                                    <field name="ai_consistency_score" widget="percentpie"/>
                                    <field name="ai_efficiency_eval" widget="badge" 
                                           decoration-success="ai_efficiency_eval == 'high'"
                                           decoration-warning="ai_efficiency_eval == 'medium'"
                                           decoration-danger="ai_efficiency_eval == 'low'"/>
                                    <field name="ai_audit_time"/>
                                </group>
                                <group string="Cảnh báo Rủi ro">
                                    <field name="ai_risk_flag"/>
                                </group>
                            </group>
                            <group string="Nhận xét Quản lý (AI Feedback)">
                                <field name="ai_manager_feedback" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree view for Báo cáo Tiến độ -->
    <record id="view_bao_cao_tien_do_tree" model="ir.ui.view">
        <field name="name">bao.cao.tien.do.tree</field>
        <field name="model">bao.cao.tien.do</field>
        <field name="arch" type="xml">
            <tree string="Báo cáo Tiến độ" decoration-info="trang_thai=='draft'"
                  decoration-success="trang_thai=='reviewed'"
                  decoration-warning="trang_thai=='submitted'"
                  decoration-danger="ai_risk_flag==True">
                <field name="name"/>
                <field name="nguoi_bao_cao_id"/>
                <field name="du_an_id"/>
                <field name="tac_vu_id" optional="show"/>
                <field name="ngay_bao_cao"/>
                <field name="ai_consistency_score" optional="hide"/>
                <field name="ai_risk_flag" optional="show"/>
                <field name="trang_thai" widget="badge"
                       decoration-info="trang_thai=='draft'"
                       decoration-success="trang_thai=='reviewed'"
                       decoration-warning="trang_thai=='submitted'"/>
            </tree>
        </field>
    </record>

    <!-- Kanban view for Báo cáo Tiến độ -->
    <record id="view_bao_cao_tien_do_kanban" model="ir.ui.view">
        <field name="name">bao.cao.tien.do.kanban</field>
        <field name="model">bao.cao.tien.do</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="nguoi_bao_cao_id"/>
                <field name="du_an_id"/>
                <field name="ngay_bao_cao"/>
                <field name="so_hinh_anh"/>
                <field name="trang_thai"/>
                <field name="ai_risk_flag"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb8">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span class="badge" t-att-class="{'badge-info': record.trang_thai.raw_value === 'draft', 'badge-warning': record.trang_thai.raw_value === 'submitted', 'badge-success': record.trang_thai.raw_value === 'reviewed'}">
                                    <field name="trang_thai"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted">
                                    <i class="fa fa-user"/> <field name="nguoi_bao_cao_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-briefcase"/> <field name="du_an_id"/>
                                </div>
                                <div t-if="record.ai_risk_flag.raw_value" class="badge badge-danger">
                                    <i class="fa fa-warning"/> Rủi ro
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <i class="fa fa-clock-o"/> <field name="ngay_bao_cao"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge badge-pill">
                                        <i class="fa fa-image"/> <field name="so_hinh_anh"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view for Báo cáo Tiến độ -->
    <record id="view_bao_cao_tien_do_search" model="ir.ui.view">
        <field name="name">bao.cao.tien.do.search</field>
        <field name="model">bao.cao.tien.do</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm báo cáo">
                <field name="name"/>
                <field name="nguoi_bao_cao_id"/>
                <field name="du_an_id"/>
                <field name="tac_vu_id"/>
                <field name="cong_viec_id"/>
                <filter string="Nháp" name="draft" 
                        domain="[('trang_thai', '=', 'draft')]"/>
                <filter string="Đã gửi" name="submitted" 
                        domain="[('trang_thai', '=', 'submitted')]"/>
                <filter string="Đã xem" name="reviewed" 
                        domain="[('trang_thai', '=', 'reviewed')]"/>
                <separator/>
                <filter string="Rủi ro (AI)" name="risk" 
                        domain="[('ai_risk_flag', '=', True)]"/>
                <separator/>
                <filter string="Hôm nay" name="today"
                        domain="[('ngay_bao_cao', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Dự án" name="group_du_an" 
                            context="{'group_by': 'du_an_id'}"/>
                    <filter string="Người báo cáo" name="group_nguoi_bao_cao" 
                            context="{'group_by': 'nguoi_bao_cao_id'}"/>
                    <filter string="Trạng thái" name="group_trang_thai" 
                            context="{'group_by': 'trang_thai'}"/>
                    <filter string="Ngày báo cáo" name="group_ngay" 
                            context="{'group_by': 'ngay_bao_cao:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Báo cáo Tiến độ -->
    <record id="action_bao_cao_tien_do" model="ir.actions.act_window">
        <field name="name">Báo cáo Tiến độ</field>
        <field name="res_model">bao.cao.tien.do</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_bao_cao_tien_do_search"/>
        <field name="context">{'search_default_today': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo báo cáo tiến độ đầu tiên!
            </p>
            <p>
                Báo cáo tiến độ cho phép bạn ghi lại kết quả công việc bằng văn bản 
                và hình ảnh minh chứng, tự động thông báo cho quản lý dự án.
            </p>
        </field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_bao_cao_tien_do" 
              name="Báo cáo Tiến độ"
              parent="menu_root"
              action="action_bao_cao_tien_do"
              sequence="7"/>

</odoo>
