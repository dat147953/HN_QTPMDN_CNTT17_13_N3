<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cong_viec_tree" model="ir.ui.view">
        <field name="name">cong.viec.tree</field>
        <field name="model">cong.viec</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="du_an_id"/>
                <field name="uu_tien"/>
                <field name="trang_thai"/>
                <field name="trong_so"/>
                <field name="phan_tram_hoan_thanh" widget="progressbar"/>
                <field name="thoi_gian_du_kien"/>
                <field name="deadline"/>
            </tree>
        </field>
    </record>

    <record id="view_cong_viec_form" model="ir.ui.view">
        <field name="name">cong.viec.form</field>
        <field name="model">cong.viec</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="trang_thai" widget="statusbar" statusbar_visible="not_started,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-tasks" type="object" name="action_view_tac_vu" attrs="{'invisible': [('so_tac_vu', '=', 0)]}">
                            <field name="so_tac_vu_hoan_thanh" widget="statinfo" string="Hoàn thành"/>
                            <span class="o_stat_text">/ <field name="so_tac_vu" readonly="1"/> tác vụ</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Tên công việc..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="du_an_id"/>
                            <field name="moc_id" domain="[('du_an_id', '=', du_an_id)]"/>
                            <field name="thanh_vien_ids" widget="many2many_tags"/>
                            <field name="uu_tien"/>
                        </group>
                        <group>
                            <field name="phan_tram_hoan_thanh" widget="progressbar"/>
                            <field name="trong_so"/>
                            <field name="thoi_gian_du_kien"/>
                            <field name="thoi_gian_thuc_te" readonly="1"/>
                            <field name="deadline"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả">
                            <field name="mo_ta" placeholder="Mô tả chi tiết công việc..."/>
                        </page>
                        <page string="Tác vụ con" name="tac_vu">
                            <field name="tac_vu_ids">
                                <tree editable="bottom" decoration-success="trang_thai=='done'" decoration-info="trang_thai=='doing'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="nguoi_thuc_hien_id"/>
                                    <field name="deadline"/>
                                    <field name="thoi_gian_du_kien"/>
                                    <field name="trong_so"/>
                                    <field name="trang_thai"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cong_viec_list" model="ir.actions.act_window">
        <field name="name">Danh sách công việc</field>
        <field name="res_model">cong.viec</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>