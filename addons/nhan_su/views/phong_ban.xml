<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Phòng ban Form View -->
        <record id="view_phong_ban_form" model="ir.ui.view">
            <field name="name">phong_ban.form</field>
            <field name="model">phong_ban</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="ten_phong_ban"/>
                            <h1>
                                <field name="ten_phong_ban" placeholder="Tên phòng ban..."/>
                            </h1>
                        </div>
                        <group>
                            <group string="Thông tin chung">
                                <field name="ma_phong_ban"/>
                                <field name="mo_ta"/>
                            </group>
                            <group string="Ban lãnh đạo">
                                <field name="truong_phong_id"/>
                                <field name="pho_phong_id"/>
                                <field name="so_nhan_vien"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Nhân viên" name="nhan_vien">
                                <field name="nhan_vien_ids">
                                    <tree>
                                        <field name="ma_dinh_danh"/>
                                        <field name="ho_va_ten"/>
                                        <field name="vai_tro"/>
                                        <field name="chuc_vu_id"/>
                                        <field name="email"/>
                                        <field name="so_dien_thoai"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Phòng ban Tree View -->
        <record id="view_phong_ban_tree" model="ir.ui.view">
            <field name="name">phong_ban.tree</field>
            <field name="model">phong_ban</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ma_phong_ban"/>
                    <field name="ten_phong_ban"/>
                    <field name="truong_phong_id"/>
                    <field name="so_nhan_vien"/>
                </tree>
            </field>
        </record>

        <!-- Phòng ban Kanban View - Org Chart Style -->
        <record id="view_phong_ban_kanban" model="ir.ui.view">
            <field name="name">phong_ban.kanban</field>
            <field name="model">phong_ban</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="ma_phong_ban"/>
                    <field name="ten_phong_ban"/>
                    <field name="truong_phong_id"/>
                    <field name="so_nhan_vien"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="ten_phong_ban"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="text-muted small">
                                        <i class="fa fa-building-o" title="Mã phòng ban"/> <field name="ma_phong_ban"/>
                                    </div>
                                    <div t-if="record.truong_phong_id.value" class="mt-1">
                                        <i class="fa fa-user" title="Trưởng phòng"/> <field name="truong_phong_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge bg-primary">
                                            <i class="fa fa-users" title="Số nhân viên"/> <field name="so_nhan_vien"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View -->
        <record model="ir.ui.view" id="phong_ban_search">
            <field name="model">phong_ban</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ma_phong_ban"/>
                    <field name="ten_phong_ban"/>
                    <field name="truong_phong_id"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_phong_ban" model="ir.actions.act_window">
            <field name="name">Phòng ban</field>
            <field name="res_model">phong_ban</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="phong_ban_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo phòng ban đầu tiên
                </p>
            </field>
        </record>
    </data>
</odoo>